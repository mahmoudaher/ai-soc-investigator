# Backend API
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/CaseFile
AUTO_CREATE_TABLES=true
DB_ECHO=false

# LLM-backed SOC agents
GEMINI_API_KEY=

# Optional enrichment for recon_agent
VIRUSTOTAL_API_KEY=

# Dashboard to FastAPI bridge
AI_SOC_API_URL=http://localhost:8000
NEXT_PUBLIC_AI_SOC_API_URL=http://localhost:8000

# Optional frontend services
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/auth/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/auth/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard/overview
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard/overview
NEXT_PUBLIC_SENTRY_DISABLED=true

